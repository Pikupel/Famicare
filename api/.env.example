NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=generate-a-random-secret-at-least-48-bytes
CORS_ORIGINS=https://your-admin-domain.example

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=bcrypt-hash-generated-by-npm-run-admin-setup
ADMIN_TOTP_SECRET=base32-totp-secret
ADMIN_SESSION_SECRET=generate-a-random-secret-at-least-48-bytes

ALLOW_UNVERIFIED_REGISTRATION=false
SMS_WEBHOOK_URL=https://your-sms-provider.example/send
SMS_WEBHOOK_TOKEN=your-sms-webhook-token

REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_api_key
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_WEBHOOK_AUTH=Bearer your-random-webhook-authorization-value
REVENUECAT_WEBHOOK_SIGNING_SECRET=your-revenuecat-hmac-signing-secret
